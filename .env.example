# Copy this file to .env.local and fill in real values.
# Never commit .env.local or real secrets to version control.

# --- Database ---
# Postgres connection string (Supabase, Neon, Railway, RDS, etc.)
# --- Database & Auth (Supabase) ---
# Create a free project at https://supabase.com, then find these under
# Project Settings > API. The anon key is safe to expose to the browser
# (that's how Supabase is designed) — never expose the service role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Used by the payments flow (lib/supabase/admin.ts) to write payment
# records server-side, bypassing RLS. Never expose this to the browser —
# it's the one key in this file with the power to bypass all security
# rules, treat it with the same care as a database password.
SUPABASE_SERVICE_ROLE_KEY=

DATABASE_URL=

# --- Authentication ---
# Random 32+ character secret used to sign sessions/JWTs.
AUTH_SECRET=

# --- OpenAI (AI Consultant, Health Check insights, Launch Wizard, AI Tools) ---
# Optional if GROQ_API_KEY is set instead (see below) — OpenAI is preferred
# if both are present.
OPENAI_API_KEY=

# --- Groq (free alternative to OpenAI for testing the AI Consultant) ---
# Get a free key (no credit card) at https://console.groq.com/keys
# Uses the same OpenAI-compatible request format, so no code changes needed.
GROQ_API_KEY=

# --- Paystack (payments) ---
# PAYSTACK_SECRET_KEY is the only one actually required by the current
# implementation — it's used server-side to create hosted checkout
# sessions and to verify transactions. Use your TEST key
# (sk_test_...) while testing; nothing charges real money against test
# keys regardless of amount.
PAYSTACK_SECRET_KEY=
# Not used by the current server-to-server (redirect) integration —
# reserved in case a future stage adds Paystack's inline/client-side
# checkout widget instead, which does need this exposed to the browser.
PAYSTACK_PUBLIC_KEY=

# --- Email (transactional notifications) ---
# e.g. Resend, Postmark, or SMTP credentials — added when email is wired up.
EMAIL_FROM=archbusinessline@gmail.com
RESEND_API_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
